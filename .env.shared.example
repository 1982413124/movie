# Copy to .env.shared. Never commit real connection strings or API keys.
# Neon: same project, branch and database for every member.
# Use the DIRECT connection string (Connection pooling OFF), with TLS enabled.
DATABASE_URL=

FLASK_PORT=5000
FRONTEND_PORT=3000

# Optional reservation emails. Enable only with your verified Resend sender/key.
# Every member's worker uses the same DB outbox; row locking prevents duplicate delivery.
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=
RESEND_API_KEY=
