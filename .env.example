# Existing local development settings. Keep real credentials in .env only.
POSTGRES_DB=movie
POSTGRES_USER=postgres
# Local development default used by this checkout. Use private credentials for hosted environments.
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
FLASK_PORT=5000
FLASK_ENV=development
FLASK_APP=app.py
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Enable after verifying your sending domain in Resend and creating an API key.
MAIL_ENABLED=false
# An address on your verified domain, e.g. no-reply@your-domain.example
MAIL_FROM_ADDRESS=
# Server-only: never use NEXT_PUBLIC_ or commit the real key.
RESEND_API_KEY=
